{
  "name": "etsy-reading-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.7.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "worker": "tsx --env-file=.env.local scripts/worker.ts",
    "typecheck:core": "tsc --noEmit -p tsconfig.core.json",
    "local:configure": "node scripts/configure-local.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.1",
    "postgres": "3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.4",
    "next-auth": "5.0.0-beta.30"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@electric-sql/pglite": "0.4.3"
  },
  "pnpm": {
    "overrides": {
      "vite": "8.0.5",
      "@emnapi/core": "1.11.1"
    }
  },
  "type": "module"
}
