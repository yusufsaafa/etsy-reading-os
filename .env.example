DATABASE_URL=postgresql://postgres:postgres@localhost:5432/etsy_reading_os
AUTH_SECRET=
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Dev credentials work only outside production and with adapter=fixtures.
# Persistent email/password accounts for synthetic development only. Always off in production.
DEV_ACCOUNT_AUTH_ENABLED=true
DEV_LOGIN_ENABLED=true
DEV_LOGIN_PASSWORD=
ETSY_ADAPTER=fixtures
# Separate 32-byte base64 key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_KEY=
SECRET_KEY_ID=local-v1
# Application login, separate from Etsy authorization. Optional in fixture development.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Live Etsy OAuth only; live intake adapter deliberately gated pending contract verification.
ETSY_CLIENT_ID=
ETSY_SHARED_SECRET=
ETSY_REDIRECT_URI=
ETSY_LIVE_OAUTH_ENABLED=false

# Generation: explicit opt-in. fake is development + synthetic fixture stores only.
AI_PROVIDER=
# Defaults: deterministic-v1 for fake, gemini-3.5-flash-lite for google.
AI_GENERATION_MODEL=
GEMINI_API_KEY=
# Required for google: exact integer USD nanos; $1 = 1,000,000,000 nanos.
AI_DAILY_BUDGET_NANOS=
AI_ATTEMPT_BUDGET_NANOS=
# One controlled live acceptance only; not read by normal tests/build.
LIVE_AI_ACCEPTANCE=
LIVE_AI_USER_ID=
LIVE_AI_STORE_ID=
LIVE_AI_UNIT_ID=

# Scheduling only: bounded claim count per cycle; no production execution yet.
PRODUCTION_CLAIM_BATCH_SIZE=4

# Exact local HTTPS tunnel hosts; development only. No scheme/path/wildcard.
READING_OS_DEV_ORIGINS=
