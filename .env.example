DATABASE_URL=postgresql://postgres:postgres@localhost:5432/etsy_reading_os
AUTH_SECRET=
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Dev credentials work only outside production and with adapter=fixtures.
DEV_LOGIN_ENABLED=true
DEV_LOGIN_PASSWORD=
ETSY_ADAPTER=fixtures
# Separate 32-byte base64 key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_KEY=
SECRET_KEY_ID=local-v1
# Application login, separate from Etsy authorization. Optional in fixture development.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Live Etsy OAuth only; live intake adapter deliberately gated pending contract verification.
ETSY_CLIENT_ID=
ETSY_SHARED_SECRET=
ETSY_REDIRECT_URI=
ETSY_LIVE_OAUTH_ENABLED=false
